# Copy to .env and adjust before running `docker compose up`.
# Every value here has a working default in docker-compose.yml already —
# this file only needs real values for production.

# --- Database ---
POSTGRES_USER=tectovault
POSTGRES_PASSWORD=tectovault_dev_password
POSTGRES_DB=tectovault_db
POSTGRES_PORT=5432

# --- API (apps/api) ---
ENVIRONMENT=development
# Generate a real value for production, e.g.: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-in-production-1234567890
CORS_ORIGINS=http://localhost:3000
API_PORT=8000

# Leave RESEND_API_KEY blank to log emails instead of sending them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TectoVault <hello@yourdomain.com>
NOTIFICATION_EMAIL=you@yourdomain.com

# First admin account, created/updated automatically on container startup.
# Unset both once the real admin account exists in production.
FIRST_ADMIN_EMAIL=admin@tectovault.example
FIRST_ADMIN_PASSWORD=ChangeMe123!

# --- Web (apps/web) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_PORT=3000
