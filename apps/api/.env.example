ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://tectovault:password@localhost:5432/tectovault_db
CORS_ORIGINS=http://localhost:3000

# Leave blank to log emails instead of sending them (safe default for dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TectoVault <hello@yourdomain.com>
NOTIFICATION_EMAIL=you@yourdomain.com

# Only used by scripts/seed_admin.py
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
