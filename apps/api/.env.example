ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://tectovault:password@localhost:5432/tectovault_db
CORS_ORIGINS=http://localhost:3000

# Leave blank to log emails instead of sending them (safe default for dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TectoVault <hello@yourdomain.com>
NOTIFICATION_EMAIL=you@yourdomain.com

# Shared secret for saving the website's AI agent chats (admin panel → AI chats).
# Set the same value as AGENT_LOG_KEY on the website. Empty = chats aren't saved.
AGENT_LOG_KEY=
# Days a saved chat is kept before it's deleted automatically
CHAT_RETENTION_DAYS=90
# Places in the pilot programme shown on the website
PILOT_PLACES=5

# Only used by scripts/seed_admin.py
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
